<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="CrossBrowser Suite" parallel="tests" thread-count="3">

    <test name="Chromium">
        <parameter name="browser" value="chromium"/>
        <classes>
            <class name="tests.AddressOfBranches"/>
            <class name="tests.ValidateATM"/>
            <class name="tests.ValidateDepositQrMessageWithText"/>
            <class name="tests.ValidateQrMessageForLoanAndLoanCalculation"/>
            <class name="tests.ValidateQrMessageForPersonalBanking"/>
        </classes>
    </test>

    <test name="Firefox">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="tests.AddressOfBranches"/>
            <class name="tests.ValidateATM"/>
            <class name="tests.ValidateDepositQrMessageWithText"/>
            <class name="tests.ValidateQrMessageForLoanAndLoanCalculation"/>
            <class name="tests.ValidateQrMessageForPersonalBanking"/>
        </classes>
    </test>

    <test name="WebKit">
        <parameter name="browser" value="webkit"/>
        <classes>
            <class name="tests.AddressOfBranches"/>
            <class name="tests.ValidateATM"/>
            <class name="tests.ValidateDepositQrMessageWithText"/>
            <class name="tests.ValidateQrMessageForLoanAndLoanCalculation"/>
            <class name="tests.ValidateQrMessageForPersonalBanking"/>
        </classes>
    </test>

</suite>